# Read by docker --env-file. Use KEY=value, without shell quotes or export.
# TEMPO_URL must be reachable FROM THE CONTAINER.
TRACE_MODE=tempo
AUTH_MODE=ldap
PUBLIC_ORIGIN=http://traceyard.example.internal
# Existing PostgreSQL reachable from this container. Set the real password on the
# target node; URL-encode reserved characters. This example contains no secret.
DATABASE_URL=postgresql://traceyard:REPLACE_ON_NODE@postgres.example.internal:5432/traceyard
ADMIN_UPN=admin@example.org
LDAP_REALMS=[{"name":"main","domain":"example.org","url":"ldap://ldap.example.org:3268","base_dn":"DC=example,DC=org","aliases":["main"]},{"name":"regions","domain":"regions.example.org","url":"ldap://regions.example.org:3268","base_dn":"DC=regions,DC=example,DC=org","aliases":[]}]
SESSION_TTL_SECONDS=28800
AUDIT_RETENTION_DAYS=30
HTTP_MAX_CONCURRENCY=16
# Keep empty unless a verified reverse proxy supplies X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
TEMPO_URL=http://tempo.example.internal:3200
TEMPO_TIMEOUT_SECONDS=30

# Keep these values for the supplied systemd unit.
HOST=0.0.0.0
PORT=8080

# Optional Tempo authentication / multitenancy. Choose bearer OR basic auth.
# TEMPO_TENANT_ID=tenant-name
# TEMPO_BEARER_TOKEN=replace-on-the-node
# TEMPO_USERNAME=replace-on-the-node
# TEMPO_PASSWORD=replace-on-the-node

# Replace ADMIN_UPN and the explicit LDAP_REALMS JSON list for your deployment.
# For an isolated local demo use TRACE_MODE=demo and AUTH_MODE=disabled.
