name: CI
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_USER: traceyard
          POSTGRES_PASSWORD: test-only-password
          POSTGRES_DB: traceyard_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U traceyard -d traceyard_test"
          --health-interval 5s --health-timeout 5s --health-retries 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
          cache: pip
      - run: python -m pip install -r requirements.txt
      - run: python -B -m unittest discover -s tests -v
        env:
          TEST_DATABASE_URL: postgresql://traceyard:test-only-password@127.0.0.1:5432/traceyard_test
      - run: node --check static/app.js
      - uses: azure/setup-helm@v4.3.0
        with:
          version: v3.17.3
      - run: helm lint chart --strict -f deploy/values.example.yml
      - run: docker build --tag traceyard:ci .
